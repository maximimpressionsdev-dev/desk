DATABASE_URL=postgresql://tickets:tickets@localhost:5432/tickets
# Local Homebrew Postgres example:
# DATABASE_URL=postgresql://YOUR_USER@localhost:5432/company_tickets

AUTH_SECRET=nextauth_secret_key
NEXTAUTH_SECRET=nextauth_secret_key
AUTH_TRUST_HOST=true
# Optional. Leave unset so login stays on the current host/port.
# AUTH_URL=http://localhost:3000

# Maxim notification service (email + SMS)
NOTIFICATION_API_URL=https://api.dev.notification.maximimpressions.com
NOTIFICATION_API_KEY=
NOTIFICATION_SMS_ALIAS=MAXIM

# Legacy SMTP (unused when NOTIFICATION_API_KEY is set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=tickets@company.local

# Local file uploads (Docker volume)
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

CRON_SECRET=change-me-for-cron-jobs

# Company directory (employees + departments)
REDIS_HOST=
REDIS_PORT=63790
REDIS_DB=3
REDIS_PASSWORD=

# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Direct Postgres connection (Settings → Database → Connection string → URI)
# Use this to bootstrap/sync against Supabase instead of local Postgres:
# SUPABASE_DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
